# Salin file ini menjadi .env lalu isi, kemudian restart server (npm start).
# Hanya dibutuhkan untuk tombol "Analisis dengan Claude"; fitur lain jalan tanpa ini.
ANTHROPIC_API_KEY=sk-ant-...

# Opsional
# ANTHROPIC_MODEL=claude-opus-5-5
# COST_OF_EQUITY=0.12        # asumsi biaya ekuitas untuk valuasi
# LONG_TERM_GROWTH=0.05      # asumsi pertumbuhan jangka panjang
# MACD_SOURCE=hist           # hist | line
